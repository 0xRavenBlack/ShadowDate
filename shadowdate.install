# ShadowDate install scripts — enable and start the reminder service for the
# user who runs the install (pacman installs run as root, so systemctl --user
# must be steered at that user's own manager via `-M user@.host`).

post_install() {
    shadowdate_userctl daemon-reload
    shadowdate_userctl enable --now shadowdate-service.service
}

post_upgrade() {
    shadowdate_userctl daemon-reload
    shadowdate_userctl enable --now shadowdate-service.service
    # Restart so the freshly installed binary takes over.
    shadowdate_userctl try-restart shadowdate-service.service
}

pre_remove() {
    shadowdate_userctl disable --now shadowdate-service.service
}

post_remove() {
    shadowdate_userctl daemon-reload
}

# Run a `systemctl --user` command for the user who triggered the install.
# Falls back to a plain call (which may target root) and only warns on failure;
# the app's Settings dialog remains available as a manual fallback.
shadowdate_userctl() {
    local user="${SUDO_USER:-${LOGNAME:-${USER}}}"
    if [ -z "$user" ]; then
        return 0
    fi
    if systemctl --user -M "${user}@.host" "$@" 2>/dev/null; then
        return 0
    fi
    if systemctl --user "$@" 2>/dev/null; then
        return 0
    fi
    echo "warning: could not reach the systemd user manager for '$user'." >&2
    echo "         start the reminder service later with: systemctl --user enable --now shadowdate-service" >&2
    return 0
}
